{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:inpred:pronto:schema:review-state:v3",
  "title": "PRONTO ReviewState v3",
  "description": "Review classes, key relevant findings, section QC and presentation figures.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "reportId",
    "revision",
    "status",
    "reviewer",
    "createdAt",
    "updatedAt",
    "variantReviews",
    "runQcAssessment",
    "notes",
    "valueCorrections",
    "findingReviews",
    "biomarkerReviews",
    "presentationFigures",
    "sectionQc"
  ],
  "properties": {
    "schemaVersion": {
      "const": "3.0"
    },
    "reportId": {
      "$ref": "#/$defs/identifier"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "status": {
      "enum": [
        "DRAFT",
        "FINAL"
      ]
    },
    "reviewer": {
      "$ref": "#/$defs/reviewer"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "finalizedAt": {
      "type": "string",
      "format": "date-time"
    },
    "finalizedBy": {
      "$ref": "#/$defs/identifier"
    },
    "lastSavedAttribution": {
      "$ref": "#/$defs/attribution"
    },
    "finalizationAttribution": {
      "$ref": "#/$defs/attribution"
    },
    "variantReviews": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/variantReview"
      }
    },
    "runQcAssessment": {
      "$ref": "#/$defs/runQcAssessment"
    },
    "notes": {
      "$ref": "#/$defs/notes"
    },
    "valueCorrections": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/valueCorrection"
      }
    },
    "findingReviews": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/findingReview"
      }
    },
    "biomarkerReviews": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/biomarkerReview"
      }
    },
    "presentationFigures": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "$ref": "#/$defs/presentationFigure"
      }
    },
    "sectionQc": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "variants",
        "cnv",
        "rna",
        "signatures"
      ],
      "properties": {
        "variants": {
          "$ref": "#/$defs/runQcAssessment"
        },
        "cnv": {
          "$ref": "#/$defs/runQcAssessment"
        },
        "rna": {
          "$ref": "#/$defs/runQcAssessment"
        },
        "signatures": {
          "$ref": "#/$defs/runQcAssessment"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "FINAL"
          }
        }
      },
      "then": {
        "required": [
          "finalizedAt",
          "finalizedBy"
        ]
      },
      "else": {
        "not": {
          "anyOf": [
            {
              "required": [
                "finalizedAt"
              ]
            },
            {
              "required": [
                "finalizedBy"
              ]
            }
          ]
        }
      }
    }
  ],
  "$defs": {
    "attribution": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "declaredInitials",
            "method"
          ],
          "properties": {
            "declaredInitials": {
              "type": "string",
              "pattern": "^[A-Z\u00c6\u00d8\u00c5]{2,8}$",
              "maxLength": 8,
              "not": {
                "pattern": "[^A-Z\u00c6\u00d8\u00c5]"
              }
            },
            "method": {
              "const": "SELF_REPORTED"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "actorId",
            "actorLabel",
            "method"
          ],
          "properties": {
            "actorId": {
              "$ref": "#/$defs/identifier"
            },
            "actorLabel": {
              "type": "string",
              "minLength": 1,
              "maxLength": 301
            },
            "method": {
              "const": "AUTHENTICATED"
            }
          }
        }
      ]
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewerId"
      ],
      "properties": {
        "reviewerId": {
          "$ref": "#/$defs/identifier"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "variantReview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "variantId",
        "reportingDecision",
        "clinicalClassification",
        "igvAssessment",
        "reportHighlight"
      ],
      "properties": {
        "variantId": {
          "$ref": "#/$defs/identifier"
        },
        "reportingDecision": {
          "enum": [
            "UNREVIEWED",
            "INCLUDE",
            "EXCLUDE"
          ]
        },
        "clinicalClassification": {
          "enum": [
            "UNCLASSIFIED",
            "BENIGN",
            "VUS",
            "ONCOGENIC"
          ]
        },
        "igvAssessment": {
          "enum": [
            "NOT_REVIEWED",
            "SUPPORTS",
            "DOES_NOT_SUPPORT",
            "INCONCLUSIVE",
            "NOT_APPLICABLE"
          ]
        },
        "comment": {
          "type": "string",
          "maxLength": 10000
        },
        "reportHighlight": {
          "type": "boolean"
        },
        "legacyClinicalClassification": {
          "enum": [
            "PATHOGENIC",
            "OTHER"
          ]
        }
      }
    },
    "runQcAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "NOT_REVIEWED",
            "PASS",
            "FAIL",
            "CONDITIONAL"
          ]
        },
        "comment": {
          "type": "string",
          "maxLength": 10000
        }
      }
    },
    "notes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "biomarkerContext",
        "additional",
        "importedLegacyNote",
        "history",
        "variantDescription",
        "references",
        "followUp",
        "assayMethods",
        "clinicalEvidence",
        "clinicalTrials",
        "patientDetails"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "maxLength": 50000
        },
        "biomarkerContext": {
          "type": "string",
          "maxLength": 50000
        },
        "additional": {
          "type": "string",
          "maxLength": 50000
        },
        "importedLegacyNote": {
          "type": "string",
          "maxLength": 50000
        },
        "history": {
          "type": "string",
          "maxLength": 50000
        },
        "variantDescription": {
          "type": "string",
          "maxLength": 50000
        },
        "references": {
          "type": "string",
          "maxLength": 50000
        },
        "followUp": {
          "type": "string",
          "maxLength": 50000
        },
        "assayMethods": {
          "type": "string",
          "maxLength": 50000
        },
        "clinicalEvidence": {
          "type": "string",
          "maxLength": 50000
        },
        "clinicalTrials": {
          "type": "string",
          "maxLength": 50000
        },
        "patientDetails": {
          "type": "string",
          "maxLength": 50000
        }
      }
    },
    "correctionValue": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ],
      "maxLength": 10000
    },
    "valueCorrection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "originalValue",
        "correctedValue",
        "reason",
        "author",
        "timestamp"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/",
          "maxLength": 512
        },
        "originalValue": {
          "$ref": "#/$defs/correctionValue"
        },
        "correctedValue": {
          "$ref": "#/$defs/correctionValue"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "author": {
          "$ref": "#/$defs/identifier"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "findingReview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "findingId",
        "reportingDecision",
        "reportHighlight"
      ],
      "properties": {
        "findingId": {
          "$ref": "#/$defs/identifier"
        },
        "reportingDecision": {
          "enum": [
            "UNREVIEWED",
            "INCLUDE",
            "EXCLUDE"
          ]
        },
        "reportHighlight": {
          "type": "boolean"
        },
        "comment": {
          "type": "string",
          "maxLength": 10000
        }
      }
    },
    "biomarkerReview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metricId",
        "reportHighlight"
      ],
      "properties": {
        "metricId": {
          "$ref": "#/$defs/identifier"
        },
        "reportHighlight": {
          "type": "boolean"
        }
      }
    },
    "presentationFigure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "figureId",
        "caption"
      ],
      "properties": {
        "figureId": {
          "type": "string",
          "format": "uuid"
        },
        "caption": {
          "type": "string",
          "maxLength": 2000
        }
      }
    }
  }
}
