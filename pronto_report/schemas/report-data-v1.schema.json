{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:inpred:pronto:schema:report-data:v1",
  "title": "PRONTO ReportData v1",
  "description": "Immutable source and calculated facts consumed by PRONTO output surfaces.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "reportId",
    "sample",
    "run",
    "provenance",
    "biomarkers",
    "qcMetrics",
    "variants",
    "attachments",
    "diagnostics"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "reportId": {"$ref": "#/$defs/identifier"},
    "sample": {"$ref": "#/$defs/sample"},
    "run": {"$ref": "#/$defs/run"},
    "provenance": {"$ref": "#/$defs/provenance"},
    "biomarkers": {
      "type": "array",
      "maxItems": 100,
      "items": {"$ref": "#/$defs/measurement"}
    },
    "qcMetrics": {
      "type": "array",
      "maxItems": 500,
      "items": {"$ref": "#/$defs/measurement"}
    },
    "variants": {
      "type": "array",
      "maxItems": 10000,
      "items": {"$ref": "#/$defs/variant"}
    },
    "attachments": {
      "type": "array",
      "maxItems": 100,
      "items": {"$ref": "#/$defs/attachment"}
    },
    "diagnostics": {
      "type": "array",
      "maxItems": 1000,
      "items": {"$ref": "#/$defs/diagnostic"}
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "shortText": {"type": "string", "maxLength": 512},
    "longText": {"type": "string", "maxLength": 10000},
    "sha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "scalar": {
      "type": ["string", "number", "integer", "boolean", "null"],
      "maxLength": 10000
    },
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sampleId", "patientPseudonym", "referenceBuild"],
      "properties": {
        "sampleId": {"$ref": "#/$defs/identifier"},
        "patientPseudonym": {"$ref": "#/$defs/identifier"},
        "referenceBuild": {"$ref": "#/$defs/identifier"},
        "tumourType": {"$ref": "#/$defs/shortText"},
        "specimenType": {"$ref": "#/$defs/shortText"}
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runId"],
      "properties": {
        "runId": {"$ref": "#/$defs/identifier"},
        "assay": {"$ref": "#/$defs/shortText"},
        "instrument": {"$ref": "#/$defs/shortText"}
      }
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"$ref": "#/$defs/shortText"},
        "version": {"$ref": "#/$defs/shortText"},
        "configurationHash": {"$ref": "#/$defs/sha256"}
      }
    },
    "sourceFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sha256"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 255},
        "sha256": {"$ref": "#/$defs/sha256"},
        "mediaType": {"type": "string", "minLength": 1, "maxLength": 127},
        "sizeBytes": {"type": "integer", "minimum": 0, "maximum": 1073741824}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generatedAt", "generator", "sourceFiles"],
      "properties": {
        "generatedAt": {"type": "string", "format": "date-time"},
        "generator": {"$ref": "#/$defs/generator"},
        "sourceFiles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {"$ref": "#/$defs/sourceFile"}
        }
      }
    },
    "sourceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fileName"],
      "properties": {
        "fileName": {"type": "string", "minLength": 1, "maxLength": 255},
        "record": {"type": "integer", "minimum": 1},
        "field": {"type": "string", "minLength": 1, "maxLength": 128},
        "rawValue": {"$ref": "#/$defs/scalar"}
      }
    },
    "threshold": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operator", "value"],
      "properties": {
        "operator": {"enum": ["LT", "LTE", "GT", "GTE", "EQ", "BETWEEN"]},
        "value": {"type": "number"},
        "upperValue": {"type": "number"},
        "label": {"$ref": "#/$defs/shortText"}
      },
      "allOf": [
        {
          "if": {"properties": {"operator": {"const": "BETWEEN"}}},
          "then": {"required": ["upperValue"]}
        }
      ]
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metricId", "label", "value", "source"],
      "properties": {
        "metricId": {"$ref": "#/$defs/identifier"},
        "label": {"$ref": "#/$defs/shortText"},
        "value": {"$ref": "#/$defs/scalar"},
        "unit": {"type": "string", "maxLength": 64},
        "status": {"enum": ["NOT_AVAILABLE", "PASS", "WARNING", "FAIL", "INFO"]},
        "thresholds": {
          "type": "array",
          "maxItems": 20,
          "items": {"$ref": "#/$defs/threshold"}
        },
        "source": {"$ref": "#/$defs/sourceReference"}
      }
    },
    "annotation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "value"],
      "properties": {
        "key": {"$ref": "#/$defs/identifier"},
        "value": {"$ref": "#/$defs/scalar"},
        "source": {"$ref": "#/$defs/sourceReference"}
      }
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "variantId",
        "occurrenceId",
        "sampleId",
        "referenceBuild",
        "source",
        "annotations"
      ],
      "properties": {
        "variantId": {"$ref": "#/$defs/identifier"},
        "occurrenceId": {"$ref": "#/$defs/identifier"},
        "sampleId": {"$ref": "#/$defs/identifier"},
        "referenceBuild": {"$ref": "#/$defs/identifier"},
        "chromosome": {"type": "string", "minLength": 1, "maxLength": 16},
        "position": {"type": "integer", "minimum": 1},
        "reference": {"type": "string", "minLength": 1, "maxLength": 10000},
        "alternate": {"type": "string", "minLength": 1, "maxLength": 10000},
        "gene": {"type": "string", "minLength": 1, "maxLength": 64},
        "genomicLocation": {"type": "string", "minLength": 1, "maxLength": 256},
        "dnaChange": {"type": "string", "minLength": 1, "maxLength": 512},
        "proteinChange": {"type": "string", "maxLength": 512},
        "alleleFrequency": {"type": "number", "minimum": 0, "maximum": 1},
        "annotations": {
          "type": "array",
          "maxItems": 200,
          "items": {"$ref": "#/$defs/annotation"}
        },
        "source": {"$ref": "#/$defs/sourceReference"}
      },
      "anyOf": [
        {"required": ["chromosome", "position", "reference", "alternate"]},
        {"required": ["gene", "genomicLocation", "dnaChange"]}
      ]
    },
    "attachment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assetId", "name", "mediaType", "sha256"],
      "properties": {
        "assetId": {"$ref": "#/$defs/identifier"},
        "name": {"type": "string", "minLength": 1, "maxLength": 255},
        "mediaType": {"type": "string", "minLength": 1, "maxLength": 127},
        "sha256": {"$ref": "#/$defs/sha256"},
        "description": {"$ref": "#/$defs/longText"}
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity", "code", "path", "message"],
      "properties": {
        "severity": {"enum": ["INFO", "WARNING", "ERROR"]},
        "code": {"$ref": "#/$defs/identifier"},
        "path": {"type": "string", "maxLength": 512},
        "message": {"$ref": "#/$defs/longText"}
      }
    }
  }
}
